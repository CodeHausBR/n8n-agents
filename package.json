{
    "name": "codehaus-service-financeiro",
    "version": "1.12.0",
    "description": "Service de criação de contas a pagar e receber",
    "type": "module",
    "main": "./build/biblioteca/biblioteca/index.js",
    "module": "./build/biblioteca/es/index.js",
    "types": "./build/biblioteca/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/biblioteca/types/index.d.ts",
            "import": "./build/biblioteca/es/index.js",
            "require": "./build/biblioteca/biblioteca/index.js"
        }
    },
    "files": [
        "build/biblioteca"
    ],
    "scripts": {
        "dev": "bun run build:worker && concurrently \"bun run dev:frontend\" \"bun run dev:worker:watch\"",
        "dev:frontend": "rsbuild dev --env-mode localhost --port 3000 --open",
        "dev:worker": "wrangler dev",
        "dev:worker:watch": "bun run build:worker && concurrently \"tsc -p tsconfig.worker.json --watch\" \"wrangler dev\"",
        "build": "bun run build:frontend && bun run build:worker && bun run build:lib",
        "dev:lib": "rslib build",
        "build:frontend": "rsbuild build",
        "build:lib": "rslib build",
        "build:worker": "tsc -p tsconfig.worker.json",
        "deploy": "bun run build && wrangler deploy",
        "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
        "u": "npx bun-check-updates -u"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250724.0",
        "@rsbuild/core": "^1.4.10",
        "@rsbuild/plugin-react": "^1.3.4",
        "@rslib/core": "^0.11.0",
        "@tailwindcss/postcss": "^4.1.11",
        "@types/node": "^24.1.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.2.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwindcss": "4.1.11",
        "typescript": "^5.8.3",
        "wrangler": "^4.26.0"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.0.0",
        "hono": "^4.8.5",
        "immer": "^10.1.1",
        "jose": "^6.0.10",
        "lucide-react": "^0.525.0",
        "onda-types": "github:ondasegura/onda-types",
        "onda-utils": "^1.33.5",
        "react-hook-form": "^7.61.1",
        "zod": "^4.0.9",
        "zustand": "^5.0.6"
    }
}
